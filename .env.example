# Aplicação
NEXT_PUBLIC_APP_NAME=Negócio Digital
NEXT_PUBLIC_APP_DESCRIPTION=Site, clientes, orçamentos, atendimento, automações e gestão comercial em um único lugar.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false

# Supabase — chave pública pode ir ao cliente; chave secreta é SOMENTE servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Rate limiting persistente. Gere um valor longo e aleatório para produção.
RATE_LIMIT_SALT=

# Cobrança. Deixe disabled enquanto o Mercado Pago não estiver configurado.
BILLING_PROVIDER=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Teste E2E de isolamento (somente ambiente de teste)
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# E2E multiunidade (homologação real)
E2E_UNIT_ADMIN_EMAIL=
E2E_UNIT_ADMIN_PASSWORD=
E2E_UNIT_MEMBER_EMAIL=
E2E_UNIT_MEMBER_PASSWORD=
E2E_UNIT_ALLOWED_ID=
E2E_UNIT_BLOCKED_ID=

# Contato público (opcional; só aparece quando configurado)
SUPPORT_EMAIL=
COMMERCIAL_WHATSAPP=

# Inteligência Artificial — somente servidor. Modelo configurável pelo ambiente.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Opcional: preços em USD por 1M tokens para exibir custo estimado real.
OPENAI_INPUT_PRICE_PER_1M_USD=
OPENAI_OUTPUT_PRICE_PER_1M_USD=

# E-mail transacional — Resend (somente servidor)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_WEBHOOK_SECRET=

# Worker HTTP do outbox; gere um segredo longo e aleatório.
OUTBOX_WORKER_SECRET=

# Integrações — chave AES-256 em base64 (32 bytes). Nunca use NEXT_PUBLIC_.
INTEGRATION_ENCRYPTION_KEY=

# WhatsApp Business Platform Cloud API — somente servidor.
# Defina explicitamente a versão Graph suportada pelo seu app Meta (ex.: vXX.X).
META_GRAPH_API_VERSION=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=

# Google Calendar — OAuth 2.0 web app (somente servidor)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcional; padrão: <NEXT_PUBLIC_APP_URL>/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=

# Google Maps Geocoding v4 — somente servidor; restrinja a chave no Google Cloud.
GOOGLE_MAPS_API_KEY=

# API pública — pepper server-side para hashing HMAC das chaves opacas.
PUBLIC_API_KEY_PEPPER=

# White-label / domínios — Vercel REST API, somente servidor.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
# Use VERCEL_PROJECT_NAME como alternativa ao ID, se preferir.
VERCEL_PROJECT_NAME=
# Opcional para projetos dentro de uma Team.
VERCEL_TEAM_ID=
