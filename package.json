    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "node tests/e2e/multi-tenant.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "homologate:local": "node scripts/homologation-local.mjs",
    "test:e2e:tenant": "node tests/e2e/multi-tenant.mjs",
    "test:e2e:units": "node tests/e2e/multi-unit.mjs",
    "preflight:deploy": "node scripts/deploy-preflight.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "mercadopago": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
